BUDGET_SIM_HOST=0.0.0.0
BUDGET_SIM_PORT=8080
BUDGET_SIM_DB=data/budget_simulation.db

# Canvas / hosted-semester options (all optional; default application behavior is unchanged):
BUDGET_SIM_NO_BROWSER=1
# Recommended for a Canvas External URL that opens in a new tab:
BUDGET_SIM_SECURE_COOKIES=1
# Set to 1 only when the HTTPS-hosted application will actually run inside a Canvas iframe.
# This changes the session cookie to SameSite=None; Secure for cross-site Canvas framing.
BUDGET_SIM_CANVAS_EMBED=0
# Use private production credentials when deploying a class-wide hosted copy.
BUDGET_SIM_PROFESSOR_PASSWORD=replace_with_private_professor_password
BUDGET_SIM_DEMO_STUDENT_PASSWORD=replace_with_private_demo_student_password

# Optional Microsoft Dataverse / Dynamics 365 synchronization:
DATAVERSE_URL=https://yourenvironment.crm.dynamics.com
DATAVERSE_ACCESS_TOKEN=replace_with_oauth_access_token
